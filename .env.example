# Copy to .env and fill in. Never commit .env.
# Every variable maps to a field in web_department/config/settings.py.

# --- Core ---
# Environment: dev | staging | prod. prod forbids DEBUG=true and requires approval for deploys.
ENV=dev
# Enable debug behaviour. Startup fails if true while ENV=prod.
DEBUG=false
# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Database / cache ---
# Async SQLAlchemy URL for the platform database.
DATABASE_URL=postgresql+asyncpg://algohub:changeme@localhost:5432/algohub
REDIS_URL=redis://localhost:6379/0
# Read by docker-compose to create the postgres container (not by Settings).
POSTGRES_DB=algohub
POSTGRES_USER=algohub
POSTGRES_PASSWORD=changeme

# --- LLM routing (llm/router.py only; never import provider SDKs directly) ---
# Local-first via Ollama.
OLLAMA_BASE_URL=http://localhost:11434
# Free-tier fallbacks, all optional. Leave empty to disable a provider.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GITHUB_MODELS_TOKEN=
# Providers to try per call before giving up (IR-022). See web_department/llm/providers.yaml.
LLM_MAX_ATTEMPTS=3
# How long a cached completion/embedding stays valid, in days.
LLM_CACHE_TTL_DAYS=7
# Hard cap on LLM calls a single worker may spend on one task, independent of MAX_TASK_RETRIES.
MAX_LLM_CALLS_PER_TASK=40
# IR-024: keep true unless you've knowingly accepted that a worker's own project code may go to
# a shared/free-tier provider (it may train on prompts) - e.g. no private/local model is
# available and you've explicitly opted into that trade-off for a specific run.
CODER_CONFIDENTIAL=true
# Hours ANALYZING waits for clarification answers before proceeding with stated defaults. FR-022.
ANALYSIS_CLARIFICATION_TIMEOUT_HOURS=24

# --- API auth (api/auth.py) ---
# Bearer tokens for each user class (SRS 2.3). Leave empty to disable that role.
REQUESTER_TOKEN=
APPROVER_TOKEN=
OPERATOR_TOKEN=
# Optional: the Web Agent POSTs project status changes here (FR-004). Leave empty to disable.
STATUS_WEBHOOK_URL=
# Optional: approval requests (FR-130) are posted here - a Discord or Slack incoming-webhook URL.
# The URL is a credential: keep it out of Git.
APPROVAL_WEBHOOK_URL=
# Base URL used in notification links.
PUBLIC_API_BASE_URL=http://localhost:8000

# --- Orchestration limits ---
# Max retries per task before it is BLOCKED and escalated (0-10). FR-012.
MAX_TASK_RETRIES=3
# Max tasks run in parallel on one machine. FR-034.
MAX_PARALLEL_TASKS=2
# QA fix cycles per task before escalating: replan -> strongest model -> human review (FR-103).
MAX_FIX_CYCLES=3
# CPUs per worker workstation container. FR-064.
WORKSTATION_CPU=2
# Memory per workstation container, Docker format (512m, 4g). FR-064.
WORKSTATION_MEM=4g
# Minutes a worker may spend on one task before diagnosis. FR-053.
TASK_TIMEOUT_MIN=30
# Max live (non-RETIRED) agents of one role per project before acquire() must reuse. FR-051.
MAX_AGENTS_PER_ROLE=3
# How often the Agent Factory watchdog scans for stuck WORKING agents. FR-053.
AGENT_WATCHDOG_INTERVAL_SECONDS=60
# Host directory holding each project's bind-mounted workspace. FR-060. When running via
# `docker compose up` (orchestrator/runner.py talks to the host's Docker daemon over the mounted
# socket - Docker-outside-of-Docker, not Docker-in-Docker), this MUST be an absolute path that
# exists on the host, e.g. /home/you/algohub-workspaces - a relative path resolves inside the
# runner container and won't mean anything to the host daemon creating the sibling containers.
WORKSTATION_DATA_DIR=./data/workspaces
# War Room archive (FR-080): close() copies architecture docs, openapi.yaml, screenshots and
# reports here before the workspace is destroyed.
WAR_ROOM_ARCHIVE_DIR=./data/war_rooms
