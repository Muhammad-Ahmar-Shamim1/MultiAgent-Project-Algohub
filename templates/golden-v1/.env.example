# Postgres (used by docker-compose and by backend/app/config.py's DATABASE_URL below)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Backend (backend/app/config.py)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
JWT_SECRET=change-me-in-production-use-a-random-32-plus-byte-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000"]

# Frontend - only NEXT_PUBLIC_* variables are readable in the browser (TEMPLATE_GUIDE.md rule 1)
NEXT_PUBLIC_API_URL=http://localhost:8000
